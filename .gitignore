# Foundry-managed user uploads are not source code.
/storage/

# Existing and future user assets stay local. Explicitly allow shipped module artwork.
/assets/*
!/assets/basic-background.svg
!/assets/demo-mage.svg
!/assets/demo-warrior.svg

# Local diagnostics, screenshots, logs, caches and generated packages.
