<div class="mso-layout">
  <aside class="mso-sidebar">
    <header class="mso-section-heading">
      <h2>{{#if widgetMode}}<span data-i18n="Template.WidgetDesigns">{{msoT "Template.WidgetDesigns"}}</span>{{else}}<span data-i18n="Template.Overlays">{{msoT "Template.Overlays"}}</span>{{/if}}</h2>
      <button type="button" data-action="createOverlay" class="mso-icon-button" data-i18n-aria-label="Template.CreateOverlay" aria-label="{{msoT "Template.CreateOverlay"}}" data-i18n-title="Template.CreateOverlay" title="{{msoT "Template.CreateOverlay"}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
    </header>
    <nav class="mso-overlay-list" data-i18n-aria-label="Template.OverlayConfigurations" aria-label="{{msoT "Template.OverlayConfigurations"}}">
      {{#each overlays}}
      <button type="button" data-action="editOverlay" data-overlay-id="{{id}}" class="mso-overlay-item {{#if selected}}selected{{/if}}" {{#if selected}}aria-current="true"{{/if}}>
        <span>{{name}}</span>{{#if active}}<small class="mso-live-badge"><span data-i18n="Template.LiveBadge">{{msoT "Template.LiveBadge"}}</span></small>{{/if}}
      </button>
      {{else}}
      <p class="mso-muted mso-empty">{{#if widgetMode}}<span data-i18n="Template.EmptyWidgetDesigns">{{msoT "Template.EmptyWidgetDesigns"}}</span>{{else}}<span data-i18n="Template.EmptyOverlays">{{msoT "Template.EmptyOverlays"}}</span>{{/if}}</p>
      {{/each}}
    </nav>
    {{#unless widgetMode}}<div class="mso-sidebar-footer">
      <label for="mso-active-overlay"><span data-i18n="Template.ActiveOnStream">{{msoT "Template.ActiveOnStream"}}</span></label>
      <select id="mso-active-overlay" name="activeOverlayId">
        <option value="" data-i18n="Template.NoneTransparent">{{msoT "Template.NoneTransparent"}}</option>
        {{#each overlays}}<option value="{{id}}" {{#if active}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
      <p class="mso-help"><span data-i18n="Template.ImmediateSelectionHelp">{{msoT "Template.ImmediateSelectionHelp"}}</span></p>
    </div>{{/unless}}
    {{#unless widgetMode}}<button type="button" data-action="manageWidgets"><span data-i18n="Template.WidgetManager">{{msoT "Template.WidgetManager"}}</span></button>{{/unless}}
    {{#unless widgetMode}}<button type="button" data-action="liveControls"><i class="fa-solid fa-play" aria-hidden="true"></i> <span data-i18n="Template.LiveControls">{{msoT "Template.LiveControls"}}</span></button>{{/unless}}
    {{#unless widgetMode}}<button type="button" data-action="installDemo">{{#if demoInstalled}}<span data-i18n="Template.OpenDemo">{{msoT "Template.OpenDemo"}}</span>{{else}}<span data-i18n="Template.InstallDemo">{{msoT "Template.InstallDemo"}}</span>{{/if}}</button>{{#if demoInstalled}}<button type="button" data-action="resetDemo" class="mso-danger"><span data-i18n="Template.ResetDemo">{{msoT "Template.ResetDemo"}}</span></button>{{/if}}{{/unless}}
  </aside>

  <main class="mso-main">
    {{#if draft}}
    <header class="mso-document-heading">
      <div><p class="mso-eyebrow">{{#if widgetMode}}<span data-i18n="Template.SharedDesign">{{msoT "Template.SharedDesign"}}</span>{{else}}<span data-i18n="Template.OverlayConfiguration">{{msoT "Template.OverlayConfiguration"}}</span>{{/if}}</p><h2>{{draft.name}}</h2></div>
      <div class="mso-actions">
        <button type="button" data-action="renameOverlay" data-i18n-title="Template.RenameOverlay" title="{{msoT "Template.RenameOverlay"}}"><span data-i18n="Template.Rename">{{msoT "Template.Rename"}}</span></button>
        <button type="button" data-action="deleteOverlay" class="mso-danger" data-i18n-title="Template.DeleteOverlay" title="{{msoT "Template.DeleteOverlay"}}"><i class="fa-solid fa-trash" aria-hidden="true"></i><span class="mso-sr-only"><span data-i18n="Template.DeleteOverlay">{{msoT "Template.DeleteOverlay"}}</span></span></button>
      </div>
    </header>
    {{#if conflict}}
    <div class="mso-conflict" role="alert"><span data-i18n="Template.ConflictHelp">{{msoT "Template.ConflictHelp"}}</span><button type="button" data-action="reloadOverlay"><span data-i18n="Template.ReloadSavedVersion">{{msoT "Template.ReloadSavedVersion"}}</span></button></div>
    {{/if}}
    <div class="mso-workspace">
      {{#if widgetMode}}<section class="mso-panel mso-widget-pages"><h3><span data-i18n="Template.InformationPages">{{msoT "Template.InformationPages"}}</span></h3><div data-widget-pages></div></section>{{/if}}
      <div class="mso-visual-editor">
        <aside class="mso-tools mso-panel" data-i18n-aria-label="Template.LayerTools" aria-label="{{msoT "Template.LayerTools"}}">
          <h3><span data-i18n="Template.Tools">{{msoT "Template.Tools"}}</span></h3>
          <button type="button" data-action="selectTool" data-i18n-title="Template.SelectMove" title="{{msoT "Template.SelectMove"}}"><i class="fa-solid fa-arrow-pointer" aria-hidden="true"></i><span><span data-i18n="Template.Select">{{msoT "Template.Select"}}</span></span></button>
          <button type="button" data-action="addImage"><i class="fa-solid fa-image" aria-hidden="true"></i><span><span data-i18n="Template.AddImage">{{msoT "Template.AddImage"}}</span></span></button>
          <button type="button" data-action="addText"><i class="fa-solid fa-font" aria-hidden="true"></i><span><span data-i18n="Template.AddText">{{msoT "Template.AddText"}}</span></span></button>
          {{#if widgetMode}}
          {{#each componentDefinitions}}<button type="button" data-action="addComponent" data-component-type="{{type}}" data-i18n="Components.{{type}}">{{label}}</button>{{/each}}
          {{else}}<button type="button" data-action="addWidget"><i class="fa-solid fa-id-card" aria-hidden="true"></i><span><span data-i18n="Template.AddWidget">{{msoT "Template.AddWidget"}}</span></span></button>{{/if}}
          <input type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" data-image-upload hidden data-i18n-aria-label="Template.ChooseLayerImage" aria-label="{{msoT "Template.ChooseLayerImage"}}">
        </aside>
        <section class="mso-preview-section" data-i18n-aria-label="Template.OverlayCanvas" aria-label="{{msoT "Template.OverlayCanvas"}}">
          <div class="mso-section-heading"><h3><span data-i18n="Template.Canvas">{{msoT "Template.Canvas"}}</span></h3><label class="mso-zoom-control"><span data-i18n="Template.Zoom">{{msoT "Template.Zoom"}}</span><select data-canvas-zoom data-i18n-aria-label="Template.CanvasZoom" aria-label="{{msoT "Template.CanvasZoom"}}">{{#each zoomOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>
          <div class="mso-preview" data-preview tabindex="0" data-i18n-aria-label="Template.InteractiveCanvas" aria-label="{{msoT "Template.InteractiveCanvas"}}"></div>
          <div class="mso-canvas-caption"><span class="mso-resolution" data-resolution>{{draft.canvas.width}} × {{draft.canvas.height}}</span><span class="mso-help"><span data-i18n="Template.DragHelp">{{msoT "Template.DragHelp"}}</span></span></div>
          <p class="mso-preview-error" data-preview-error hidden role="status"></p>
          <p class="mso-help"><span data-i18n="Template.TransparencyHelp">{{msoT "Template.TransparencyHelp"}}</span></p>
          {{#if widgetMode}}<div class="mso-widget-preview-actor"><button type="button" data-action="choosePreviewActor"><span data-i18n="Template.PreviewCharacter">{{msoT "Template.PreviewCharacter"}}</span></button><button type="button" data-action="chooseDemoPreviewActor"><span data-i18n="Template.PreviewDemo">{{msoT "Template.PreviewDemo"}}</span></button><span class="mso-help" data-preview-actor>{{previewActorLabel}}</span></div><p class="mso-help"><span data-i18n="Template.PreviewCharacterHelp">{{msoT "Template.PreviewCharacterHelp"}}</span></p>{{/if}}
        </section>
        <aside class="mso-inspector mso-panel" data-i18n-aria-label="Template.LayersProperties" aria-label="{{msoT "Template.LayersProperties"}}">
          <section data-i18n-aria-label="Template.LayerList" aria-label="{{msoT "Template.LayerList"}}"><div class="mso-section-heading"><h3><span data-i18n="Template.Layers">{{msoT "Template.Layers"}}</span></h3><span class="mso-muted" data-layer-count>0</span></div><div class="mso-layer-list" data-layer-list></div><p class="mso-help"><span data-i18n="Template.LayerOrderHelp">{{msoT "Template.LayerOrderHelp"}}</span></p></section>
          <section class="mso-properties-section" data-i18n-aria-label="Template.SelectedLayerProperties" aria-label="{{msoT "Template.SelectedLayerProperties"}}"><h3><span data-i18n="Template.Properties">{{msoT "Template.Properties"}}</span></h3><div data-layer-properties></div></section>
        </aside>
      </div>
      {{#if widgetMode}}<section class="mso-panel mso-shared-animations"><h3><span data-i18n="Template.WholeWidgetAnimations">{{msoT "Template.WholeWidgetAnimations"}}</span></h3><p class="mso-help"><span data-i18n="Template.WholeWidgetHelp">{{msoT "Template.WholeWidgetHelp"}}</span></p><div data-widget-animations></div></section>{{/if}}
      {{#unless widgetMode}}<section class="mso-panel mso-animation-tests"><h3><span data-i18n="Template.AnimationTests">{{msoT "Template.AnimationTests"}}</span></h3><div data-animation-tests></div></section>{{/unless}}
      <div class="mso-settings-grid">
        <section class="mso-panel">
          <h3><span data-i18n="Template.Canvas">{{msoT "Template.Canvas"}}</span></h3>
          <div class="mso-dimensions">
            <label><span data-i18n="Template.Width">{{msoT "Template.Width"}}</span> <span><span data-i18n="Template.Pixels">{{msoT "Template.Pixels"}}</span></span><input type="number" min="64" max="7680" step="1" required value="{{draft.canvas.width}}" data-draft-field="canvas.width" data-i18n-aria-label="Template.CanvasWidth" aria-label="{{msoT "Template.CanvasWidth"}}"></label>
            <span class="mso-times" aria-hidden="true">×</span>
            <label><span data-i18n="Template.Height">{{msoT "Template.Height"}}</span> <span><span data-i18n="Template.Pixels">{{msoT "Template.Pixels"}}</span></span><input type="number" min="64" max="7680" step="1" required value="{{draft.canvas.height}}" data-draft-field="canvas.height" data-i18n-aria-label="Template.CanvasHeight" aria-label="{{msoT "Template.CanvasHeight"}}"></label>
          </div>
          <p class="mso-help">{{#if widgetMode}}<span data-i18n="Template.WidgetDimensionsHelp">{{msoT "Template.WidgetDimensionsHelp"}}</span>{{else}}<span data-i18n="Template.OBSDimensionsHelp">{{msoT "Template.OBSDimensionsHelp"}}</span>{{/if}}</p>
        </section>
        <section class="mso-panel">
          <h3><span data-i18n="Template.Background">{{msoT "Template.Background"}}</span></h3>
          <input type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" data-background-upload hidden data-i18n-aria-label="Template.ChooseBackground" aria-label="{{msoT "Template.ChooseBackground"}}">
          <div class="mso-background-actions">
            <button type="button" data-action="uploadBackground"><i class="fa-solid fa-upload" aria-hidden="true"></i> <span data-i18n="Template.UploadBackground">{{msoT "Template.UploadBackground"}}</span></button>
            <button type="button" data-action="browseBackground"><i class="fa-solid fa-folder-open" aria-hidden="true"></i> <span data-i18n="Template.BrowseExisting">{{msoT "Template.BrowseExisting"}}</span></button>
            <button type="button" data-action="removeBackground"><i class="fa-solid fa-xmark" aria-hidden="true"></i> <span data-i18n="Template.RemoveBackground">{{msoT "Template.RemoveBackground"}}</span></button>
          </div>
          <p class="mso-upload-status" data-upload-status role="status" {{#unless uploading}}hidden{{/unless}}>{{#if uploading}}<span data-i18n="Template.UploadingBackground">{{msoT "Template.UploadingBackground"}}</span>{{/if}}</p>
          <div class="mso-background-current">
            <div class="mso-background-thumbnail"><img data-background-thumbnail data-i18n-alt="Template.CurrentBackground" alt="{{msoT "Template.CurrentBackground"}}" hidden><span data-background-thumbnail-status><span data-i18n="Template.NoBackground">{{msoT "Template.NoBackground"}}</span></span></div>
            <div><span class="mso-muted"><span data-i18n="Template.CurrentImage">{{msoT "Template.CurrentImage"}}</span></span><p class="mso-background-path" data-background-path>{{#if draft.background.src}}{{draft.background.src}}{{else}}<span data-i18n="Template.NoImage">{{msoT "Template.NoImage"}}</span>{{/if}}</p></div>
          </div>
          <label class="mso-field"><span data-i18n="Template.AssetPath">{{msoT "Template.AssetPath"}}</span>
            <input type="text" value="{{draft.background.src}}" data-draft-field="background.src" data-i18n-placeholder="Template.AssetPathPlaceholder" placeholder="{{msoT "Template.AssetPathPlaceholder"}}" data-i18n-aria-label="Template.BackgroundImagePath" aria-label="{{msoT "Template.BackgroundImagePath"}}">
          </label>
          <div class="mso-background-options">
            <label><span data-i18n="Template.Scaling">{{msoT "Template.Scaling"}}</span><select data-draft-field="background.fit">{{#each fitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label><span data-i18n="Template.Opacity">{{msoT "Template.Opacity"}}</span> <output data-opacity-output>{{opacityPercent}}%</output><input type="range" min="0" max="1" step="0.01" value="{{draft.background.opacity}}" data-draft-field="background.opacity" data-i18n-aria-label="Template.BackgroundOpacity" aria-label="{{msoT "Template.BackgroundOpacity"}}"></label>
          </div>
          <p class="mso-help"><span data-i18n="Template.BackgroundHelp">{{msoT "Template.BackgroundHelp"}}</span></p>
        </section>
      </div>
    </div>
    <footer class="mso-save-bar"><span class="mso-save-status" data-save-status role="status">{{#if dirty}}<span data-i18n="Template.UnsavedChanges">{{msoT "Template.UnsavedChanges"}}</span>{{else}}<span data-i18n="Template.AllSaved">{{msoT "Template.AllSaved"}}</span>{{/if}}</span><div class="mso-actions"><button type="button" data-action="reloadOverlay"><span data-i18n="Template.ReloadSaved">{{msoT "Template.ReloadSaved"}}</span></button><button type="button" class="mso-primary" data-action="saveOverlay" {{#unless dirty}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{#if widgetMode}}<span data-i18n="Template.SaveWidget">{{msoT "Template.SaveWidget"}}</span>{{else}}<span data-i18n="Template.SaveOverlay">{{msoT "Template.SaveOverlay"}}</span>{{/if}}</button></div></footer>
    {{else}}
    <div class="mso-start"><i class="fa-solid fa-layer-group" aria-hidden="true"></i><h2>{{#if widgetMode}}<span data-i18n="Template.StartWidgetTitle">{{msoT "Template.StartWidgetTitle"}}</span>{{else}}<span data-i18n="Template.StartOverlayTitle">{{msoT "Template.StartOverlayTitle"}}</span>{{/if}}</h2><p>{{#if widgetMode}}<span data-i18n="Template.StartWidgetHelp">{{msoT "Template.StartWidgetHelp"}}</span>{{else}}<span data-i18n="Template.StartOverlayHelp">{{msoT "Template.StartOverlayHelp"}}</span>{{/if}}</p><button type="button" class="mso-primary" data-action="createOverlay">{{#if widgetMode}}<span data-i18n="Template.CreateFirstWidget">{{msoT "Template.CreateFirstWidget"}}</span>{{else}}<span data-i18n="Template.CreateFirstOverlay">{{msoT "Template.CreateFirstOverlay"}}</span>{{/if}}</button></div>
    {{/if}}

    {{#unless widgetMode}}<section class="mso-presets mso-panel">
      <div class="mso-section-heading"><h3><span data-i18n="Template.Presets">{{msoT "Template.Presets"}}</span></h3>{{#if draft}}<button type="button" data-action="savePreset"><span data-i18n="Template.SaveAsPreset">{{msoT "Template.SaveAsPreset"}}</span></button>{{/if}}</div>
      <div class="mso-preset-row"><select name="presetId" data-i18n-aria-label="Template.ChoosePreset" aria-label="{{msoT "Template.ChoosePreset"}}">{{#each presets}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if builtin}}data-i18n="Template.BuiltinName" data-i18n-param-name="{{name}}"{{/if}}>{{#if builtin}}{{msoT "Template.BuiltinName" name=name}}{{else}}{{name}}{{/if}}</option>{{/each}}</select><button type="button" data-action="loadPreset" {{#unless hasPreset}}disabled{{/unless}}><span data-i18n="Template.LoadSave">{{msoT "Template.LoadSave"}}</span></button><button type="button" data-action="duplicatePreset" {{#unless hasPreset}}disabled{{/unless}}><span data-i18n="Template.Duplicate">{{msoT "Template.Duplicate"}}</span></button><button type="button" data-action="renamePreset" {{#unless customPreset}}disabled{{/unless}}><span data-i18n="Template.Rename">{{msoT "Template.Rename"}}</span></button><button type="button" data-action="deletePreset" class="mso-danger" data-i18n-aria-label="Template.DeleteCustomPreset" aria-label="{{msoT "Template.DeleteCustomPreset"}}" data-i18n-title="Template.DeleteCustomPreset" title="{{msoT "Template.DeleteCustomPreset"}}" {{#unless customPreset}}disabled{{/unless}}><i class="fa-solid fa-trash" aria-hidden="true"></i></button></div>
      <p class="mso-help"><span data-i18n="Template.LoadPresetHelp">{{msoT "Template.LoadPresetHelp"}}</span></p>
    </section>{{/unless}}

    {{#unless widgetMode}}<section class="mso-obs mso-panel">
      <div class="mso-section-heading"><h3><span data-i18n="Template.OBSBrowserSource">{{msoT "Template.OBSBrowserSource"}}</span></h3><span class="mso-muted"><span data-i18n="Template.DedicatedSession">{{msoT "Template.DedicatedSession"}}</span></span></div>
      <label class="mso-field"><span data-i18n="Template.ViewerAccount">{{msoT "Template.ViewerAccount"}}</span><div class="mso-input-row"><select name="viewerUserId"><option value="" data-i18n="Template.ChooseViewer">{{msoT "Template.ChooseViewer"}}</option>{{#each viewerUsers}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} ({{role}})</option>{{/each}}</select><button type="button" data-action="saveViewer"><span data-i18n="Template.SaveViewer">{{msoT "Template.SaveViewer"}}</span></button></div></label>
      <p class="mso-help"><span data-i18n="Template.ViewerHelp">{{msoT "Template.ViewerHelp"}}</span></p>
      <label class="mso-field"><span data-i18n="Template.BrowserURL">{{msoT "Template.BrowserURL"}}</span><div class="mso-input-row"><input name="obsURL" type="text" readonly value="{{obsURL}}" data-i18n-aria-label="Template.OBSBrowserURL" aria-label="{{msoT "Template.OBSBrowserURL"}}"><button type="button" data-action="copyURL" data-i18n-aria-label="Template.CopyBrowserURL" aria-label="{{msoT "Template.CopyBrowserURL"}}" data-i18n-title="Template.CopyURL" title="{{msoT "Template.CopyURL"}}"><i class="fa-solid fa-copy" aria-hidden="true"></i></button></div></label>
      <p class="mso-help"><span data-i18n="Template.OBSHelpBefore">{{msoT "Template.OBSHelpBefore"}}</span> <strong><span data-i18n="Template.Interact">{{msoT "Template.Interact"}}</span></strong> <span data-i18n="Template.OBSHelpAfter">{{msoT "Template.OBSHelpAfter"}}</span></p>
      {{#if joinURL}}<label class="mso-field"><span data-i18n="Template.SignInURL">{{msoT "Template.SignInURL"}}</span><input type="text" readonly value="{{joinURL}}" data-i18n-aria-label="Template.FoundrySignInURL" aria-label="{{msoT "Template.FoundrySignInURL"}}"></label>{{/if}}
    </section>{{/unless}}
  </main>
</div>
