<main class="mso-main">
  <header class="mso-document-heading"><div><p class="mso-eyebrow"><span data-i18n="Template.ReusableDesigns">{{msoT "Template.ReusableDesigns"}}</span></p><h2><span data-i18n="Template.WidgetManager">{{msoT "Template.WidgetManager"}}</span></h2></div><button type="button" class="mso-primary" data-action="createWidgetPreset"><span data-i18n="Template.CreateWidgetPreset">{{msoT "Template.CreateWidgetPreset"}}</span></button></header>
  <p class="mso-help"><span data-i18n="Template.LibraryHelp">{{msoT "Template.LibraryHelp"}}</span></p>
  <section class="mso-widget-gallery" data-i18n-aria-label="Template.WidgetLibrary" aria-label="{{msoT "Template.WidgetLibrary"}}">
    {{#each presets}}<article class="mso-panel mso-widget-card"><h3>{{name}}</h3><div class="mso-widget-library-preview" data-widget-preview="{{id}}" data-i18n-aria-label="Template.PreviewOf" data-i18n-param-name="{{name}}" aria-label="{{msoT "Template.PreviewOf" name=name}}"></div><div class="mso-actions"><button type="button" data-widget-command="edit" data-preset-id="{{id}}"><span data-i18n="Template.EditPreview">{{msoT "Template.EditPreview"}}</span></button><button type="button" data-widget-command="rename" data-preset-id="{{id}}"><span data-i18n="Template.Rename">{{msoT "Template.Rename"}}</span></button><button type="button" data-widget-command="duplicate" data-preset-id="{{id}}"><span data-i18n="Template.Duplicate">{{msoT "Template.Duplicate"}}</span></button><button type="button" class="mso-danger" data-widget-command="delete" data-preset-id="{{id}}"><span data-i18n="Template.Delete">{{msoT "Template.Delete"}}</span></button></div></article>{{else}}<p><span data-i18n="Template.EmptyLibrary">{{msoT "Template.EmptyLibrary"}}</span></p>{{/each}}
  </section>
  <footer class="mso-save-bar"><p class="mso-help"><span data-i18n="Template.LibraryFieldsHelp">{{msoT "Template.LibraryFieldsHelp"}}</span></p><div class="mso-actions"><button type="button" data-action="installCainPresets"><span data-i18n="Template.InstallCAIN">{{msoT "Template.InstallCAIN"}}</span></button><button type="button" data-action="adapterSettings"><span data-i18n="Template.Provider">{{msoT "Template.Provider"}}</span></button><button type="button" data-action="fieldMappings"><span data-i18n="Template.Mappings">{{msoT "Template.Mappings"}}</span></button></div></footer>
</main>
